# Server runtime
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres (Supabase direct URI — NOT pooled, so migrations run in a single tx)
POSTGRES_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Email (Nodemailer transport for contact-form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# Coding stats handles (server-side fetch, cached in stats_cache table)
STATS_LEETCODE_HANDLE=
STATS_CODEFORCES_HANDLE=
STATS_GITHUB_HANDLE=

# GitHub PAT — read:user scope is enough for contributionsCollection
GITHUB_TOKEN=
